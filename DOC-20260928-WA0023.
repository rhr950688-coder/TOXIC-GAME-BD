var APK_HREF="#";
var APK_B64="";

function b64ToBlob(b64,type){
  var bin=atob(b64), len=bin.length, bytes=new Uint8Array(len);
  for(var i=0;i<len;i++){bytes[i]=bin.charCodeAt(i)}
  return new Blob([bytes],{type:type});
}
document.querySelectorAll('[data-download]').forEach(function(btn){
  btn.addEventListener('click',function(){
    try{
      if(APK_B64 && APK_B64.length>10){
        var blob=b64ToBlob(APK_B64,'application/vnd.android.package-archive');
        var url=URL.createObjectURL(blob);
        var a=document.createElement('a');
        a.href=url; a.download=APK_NAME; document.body.appendChild(a); a.click();
        document.body.removeChild(a);
        setTimeout(function(){URL.revokeObjectURL(url)},15000);
      }else{
        var a2=document.createElement('a');
        a2.href=APK_HREF; a2.download=APK_NAME; document.body.appendChild(a2); a2.click();
        document.body.removeChild(a2);
      }
